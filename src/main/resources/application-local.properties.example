# Copy this file to application-local.properties and fill in your OAuth credentials.
# Get values from your team lead or password manager.
# JWT secret must be at least 32 characters.

spring.security.oauth2.client.registration.google.client-id=YOUR_GOOGLE_CLIENT_ID
spring.security.oauth2.client.registration.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET
app.jwt.secret=local-jwt-secret-key-min-32-chars!!

# Database — matches compose.yml defaults
spring.datasource.url=jdbc:postgresql://localhost:5432/senkron
spring.datasource.username=senkron
spring.datasource.password=senkron

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
